REACT_APP_AUTHN_API_URL=https://samebook-authn-backend.vercel.app
# Relative, same-origin — routed through the /api rewrite proxy in vercel.json
# to the actual backend. This is required, not cosmetic: the frontend and
# backend are on different *.vercel.app subdomains (different sites per the
# Public Suffix List), so calling the backend's absolute URL directly makes
# every request cross-site. The auth cookies (SameSite=None) then get blocked
# by mobile browsers' third-party-cookie policies (iOS Safari/Android Chrome
# enforce this far more aggressively than desktop Chrome), breaking login on
# phones/tablets while working fine on desktop.
REACT_APP_CUSTOMERS_API_URL=/api